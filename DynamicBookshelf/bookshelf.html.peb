<!DOCTYPE html>
<html lang="en-us">
<head>
<style type="text/css">
.filelink { background-color: yellow; }
.weblink { background-color: cyan; }
</style>
{% macro expandBooks(result, category) %}
  {% for item in result %}
    {% if item.category == category %}
<h1>Category: {{ category }}</h1>
{% if item.description != '' %}
<h2>Description: {{ item.description }}</h2>
{% endif %}
      {% for book in item.books %}
<p>
        {% if book.pdf == 1 %}
  <a href="/p/web/viewer.html?file=/{{ book.link }}" target="_blank" class="filelink">{{ book.title }}</a>
          {% if book.description != '' %}
            ({{ book.description }} <i>PDF</i>)
          {% endif %}
        {% else %}
  <a href="/{{ book.link }}" target="_blank" class="weblink">{{ book.title }}</a>
          {% if book.description != '' %}
            ({{ book.description }})
          {% endif %}
        {% endif %}
</p>
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endmacro %}

</head><body><p>The following books and reference materials are included with Code on the Go.</p>
{{ expandBooks(result, 'Android') }}
{{ expandBooks(result, 'Java') }}
{{ expandBooks(result, 'Kotlin') }}
{{ expandBooks(result, 'C and C++') }}
{{ expandBooks(result, 'Pebble') }}
</body></html>
