{#
  The skeleton every page shares: a breadcrumb, the content, a footer.

  Class names follow the ones the scrape used -- api-signature, api-name-block, api-level,
  jd-inheritance-table -- so that the stylesheet here and the reference site's own describe the
  same structure, and a fragment of documentation HTML carried through the JSON (which keeps the
  classes it was written with) lands on rules that were meant for it.
#}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{% block title %}Android API reference{% endblock %}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="{{ pathToRoot }}stylesheet.css">
</head>
<body class="{% block bodyClass %}reference-page{% endblock %}">
<header>
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="{{ pathToRoot }}index.html">Android API reference</a>
{%- if packageName is not empty %}
<span class="separator">/</span>
{% if packageUrl is not empty %}<a href="{{ packageUrl }}">{{ packageName }}</a>{% else %}{{ packageName }}{% endif %}
{%- endif %}
{%- block crumb %}{% endblock %}
</nav>
</header>
<main>
{% block content %}{% endblock %}
</main>
<footer>
<p>Generated from the developer.android.com reference scrape under
<code>ProcessDocs/AndroidDocs</code>. Links that leave the scrape point back at
developer.android.com and need a network connection.</p>
</footer>
</body>
</html>
