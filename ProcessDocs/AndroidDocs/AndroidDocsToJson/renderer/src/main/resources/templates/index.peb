{#
  An index page: the generated root index, and the class and package indexes the scrape came with.

  Identical in shape to a package summary -- grouped tables of links -- but it is its own template
  because it is the entry point, and so carries no package breadcrumb of its own.

  Self-contained, with _macros.peb concatenated on; see class.peb's header.
#}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title | default(name) }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="{{ stylesheetUrl }}">
</head>
<body class="reference-page index-page">
<header>
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="{{ indexUrl }}">Android API reference</a>
<span class="separator">/</span><span class="current">{{ title | default(name) }}</span>
</nav>
</header>
<main>

<div class="page-header">
<h1>{{ title | default(name) }}</h1>
</div>

{% if description is not empty %}
<div class="description">{{ description | raw }}</div>
{% endif %}

{% if groups | length > 1 %}
<nav class="index-jump">
{% for group in groups %}<a href="#{{ group.id }}">{{ group.title }}</a>{% endfor %}
</nav>
{% endif %}

{% for group in groups %}
<div class="summary-section" id="{{ group.id }}">
<div class="table-wrapper">
<table class="summary">
<thead><tr><th colspan="2"><h2>{{ group.title }}</h2></th></tr></thead>
<tbody>
{{ summaryRows(group.rows, versionScheme) }}
</tbody>
</table>
</div>
</div>
{% endfor %}

</main>
{{ pageFooter() }}
</body>
</html>
