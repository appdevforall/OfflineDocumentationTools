{#
  A package summary: the types the package holds, grouped the way the source grouped them.

  Most of these pages are generated rather than scraped -- Dackka writes no package pages at all,
  and doclava's survive for only three packages -- so `generated` says which kind you are looking
  at. A generated page has the same shape but its rows come from the class pages themselves.
#}{% extends "base" %}
{% import "macros" %}

{% block title %}{{ title | default(name) }}{% endblock %}
{% block bodyClass %}package-page{% endblock %}

{% block content %}
<div class="page-header">
<h1>{{ title | default(name) }}</h1>
<div class="page-meta">{{ versionNote(versionScheme | default('api-level'), addedIn, deprecatedIn) }}</div>
</div>

{% if description is not empty %}
<div class="description">{{ description | doc }}</div>
{% endif %}

{% for group in groups %}
<div class="summary-section" id="{{ group.id }}">
<div class="table-wrapper">
<table class="summary">
<thead><tr><th colspan="2"><h2>{{ group.title }}</h2></th></tr></thead>
<tbody>
{{ summaryRows(group.rows, versionScheme | default('api-level')) }}
</tbody>
</table>
</div>
</div>
{% endfor %}
{% endblock %}
