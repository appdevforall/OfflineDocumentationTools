{#
  A package summary: the types the package holds, grouped the way the source grouped them.

  Most of these pages are generated rather than scraped -- Dackka writes no package pages at all,
  and doclava's survive for only three packages -- so `generated` says which kind you are looking
  at. A generated page has the same shape but its rows come from the class pages themselves.

  Self-contained, with _macros.peb concatenated on; see class.peb's header.
#}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title | default(name) }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="{{ stylesheetUrl }}">
</head>
<body class="reference-page package-page">
<header>
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="{{ indexUrl }}">Android API reference</a>
<span class="separator">/</span><span class="current">{{ title | default(name) }}</span>
</nav>
</header>
<main>

<div class="page-header">
<h1>{{ title | default(name) }}</h1>
<div class="page-meta">{{ versionNote(versionScheme, addedIn, deprecatedIn) }}</div>
</div>

{% if description is not empty %}
<div class="description">{{ description | raw }}</div>
{% endif %}

{% for group in groups %}
<div class="summary-section" id="{{ group.id }}">
<div class="table-wrapper">
<table class="summary">
<thead><tr><th colspan="2"><h2>{{ group.title }}</h2></th></tr></thead>
<tbody>
{{ summaryRows(group.rows, versionScheme) }}
</tbody>
</table>
</div>
</div>
{% endfor %}

</main>
<footer>
<p>Generated from the developer.android.com reference scrape.</p>
</footer>
</body>
</html>
