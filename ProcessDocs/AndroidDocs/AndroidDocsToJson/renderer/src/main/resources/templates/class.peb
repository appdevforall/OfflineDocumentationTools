{#
  A class, interface, enum or annotation page.

  Self-contained by design: no `extends`, no `import`, and no filter beyond `raw`. The
  documentation database stores one template per row and hands it the page's JSON as the context,
  so a template that reached for a parent or a custom filter could not run there. _macros.peb is
  concatenated onto the end of this file before compiling -- see its header.

  The order follows the reference site's: what the type is, where it sits in the hierarchy, what
  it is for, a table per group of members, then the members in full. It needs no JavaScript --
  inherited members collapse with <details>.

  Context is the page's JSON, plus three links whichever runtime is rendering works out for
  itself, because they depend on where the pages are served from rather than on the documentation:
  `stylesheetUrl`, `indexUrl` and `packageUrl`.
#}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ name }}{% if packageName is not empty %} ({{ packageName }}){% endif %}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="{{ stylesheetUrl }}">
</head>
<body class="reference-page class-page">
<header>
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="{{ indexUrl }}">Android API reference</a>
{%- if packageName is not empty %}
<span class="separator">/</span>
{% if packageUrl is not empty %}<a href="{{ packageUrl }}">{{ packageName }}</a>{% else %}{{ packageName }}{% endif %}
{%- endif %}
<span class="separator">/</span><span class="current">{{ name }}</span>
</nav>
</header>
<main>

<div class="page-header">
<h1>{{ title | default(name) }}</h1>
<div class="page-meta">
{{ versionNote(versionScheme, addedIn, deprecatedIn) }}
{% if artifact is not empty %}<div class="artifact">Artifact: {{ reference(artifact) }}</div>{% endif %}
{% if sourceUrl is not empty %}<div class="source-link"><a href="{{ sourceUrl }}" class="external-link">View source</a></div>{% endif %}
</div>
</div>

{% if signatureHtml is not empty %}
<pre class="api-signature">{{ signatureHtml | raw }}</pre>
{% endif %}

{% if deprecated %}
<aside class="caution">
{%- if deprecationLabel is not empty %}<strong>{{ deprecationLabel }}</strong>{% else %}<strong>Deprecated.</strong>{% endif %}
{%- if deprecationNote is not empty %} {{ deprecationNote | raw }}{% endif %}
</aside>
{% endif %}

{#
  The inheritance chain, indented one step per generation, as the reference tables draw it. The
  last entry is this type itself, which the extractor left without a URL because it is the page
  you are already on.
#}
{% if inheritance is not empty and inheritance | length > 1 %}
<div class="table-wrapper">
<table class="jd-inheritance-table">
{%- for ancestor in inheritance %}
{#
  One spacer cell per generation, then the class name spanning what is left of the row. The span
  is what keeps the indent even: without it the first row's name would set the width of the
  column the second row's arrow sits in.
#}
<tr>
{%- for step in range(0, loop.index) %}<td class="jd-inheritance-space">{% if loop.last %}&nbsp;&nbsp;&nbsp;&#x21b3;{% else %}&nbsp;{% endif %}</td>{% endfor %}
<td class="jd-inheritance-class-cell" colspan="{{ (inheritance | length) - loop.index }}">{{ reference(ancestor) }}</td>
</tr>
{%- endfor %}
</table>
</div>
{% endif %}

{% if implements is not empty %}
<dl class="notes"><dt>Implements:</dt><dd>{{ referenceList(implements) }}</dd></dl>
{% endif %}
{% if knownDirectSubclasses is not empty %}
<dl class="notes"><dt>Known direct subclasses:</dt><dd>{{ referenceList(knownDirectSubclasses) }}</dd></dl>
{% endif %}
{% if knownIndirectSubclasses is not empty %}
<dl class="notes"><dt>Known indirect subclasses:</dt><dd>{{ referenceList(knownIndirectSubclasses) }}</dd></dl>
{% endif %}

{% if description is not empty %}
<div class="description">{{ description | raw }}</div>
{% endif %}

{% if summary is not empty or inherited is not empty %}
<h2 id="summary">Summary</h2>
{% for section in summary %}{{ summaryTable(section, versionScheme) }}{% endfor %}
{% for section in inherited %}{{ inheritedSection(section, versionScheme) }}{% endfor %}
{% endif %}

{% for section in details %}
<h2 class="api-section" id="{{ section.id }}_1">{{ section.title }}</h2>
{% for member in section.members %}{{ memberDetail(member, versionScheme) }}{% endfor %}
{% endfor %}

</main>
<footer>
<p>Generated from the developer.android.com reference scrape. Links that leave the scrape point
back at developer.android.com and need a network connection.</p>
</footer>
</body>
</html>
