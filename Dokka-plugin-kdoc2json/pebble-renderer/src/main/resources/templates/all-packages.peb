{% extends "base" %}
{% block title %}All Packages{% endblock %}
{% block bodyClass %}all-packages-index-page{% endblock %}
{% block content %}
<div class="header"><h1 class="title">All Packages</h1></div>
<div id="all-packages-table">
<div class="caption"><span>Package Summary</span></div>
<div class="summary-table three-column-summary">
<div class="table-header col-first">Module</div>
<div class="table-header col-second">Package</div>
<div class="table-header col-last">Description</div>
{% for pkg in packages %}
<div class="col-plain {% if loop.index is odd %}odd-row-color{% else %}even-row-color{% endif %}">{{ pkg.moduleName }}</div>
<div class="col-first {% if loop.index is odd %}odd-row-color{% else %}even-row-color{% endif %}"><a href="{{ pkg.url | href }}">{{ pkg.name }}</a></div>
<div class="col-last {% if loop.index is odd %}odd-row-color{% else %}even-row-color{% endif %}"><div class="block">{{ pkg.firstSentence | doc }}</div></div>
{% endfor %}
</div>
</div>
{% endblock %}
