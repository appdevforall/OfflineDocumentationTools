{% extends "base" %}
{% block title %}Overview{% endblock %}
{% block bodyClass %}package-index-page{% endblock %}
{% block content %}
<div class="header">
<h1 class="title">{{ title | default('API Documentation') }}</h1>
</div>
<main role="main">
{% if modules is not empty %}
<div id="all-modules-table">
<div class="caption"><span>Modules</span></div>
<div class="summary-table two-column-summary">
<div class="table-header col-first">Module</div>
<div class="table-header col-last">Description</div>
{% for module in modules %}
<div class="col-first {% if loop.index is odd %}odd-row-color{% else %}even-row-color{% endif %}"><a href="{{ module.url | href }}">{{ module.name }}</a></div>
<div class="col-last {% if loop.index is odd %}odd-row-color{% else %}even-row-color{% endif %}"><div class="block">{{ module.firstSentence | doc }}</div></div>
{% endfor %}
</div>
</div>
{% endif %}
{# Only for a non-modular run: with modules present javadoc's overview lists just
   the modules, and allpackages-index.html carries the package list. #}
{% if packages is not empty and modules is empty %}
<div id="all-packages-table">
<div class="caption"><span>Packages</span></div>
<div class="summary-table three-column-summary">
<div class="table-header col-first">Module</div>
<div class="table-header col-second">Package</div>
<div class="table-header col-last">Description</div>
{% for pkg in packages %}
<div class="col-plain {% if loop.index is odd %}odd-row-color{% else %}even-row-color{% endif %}">{{ pkg.moduleName }}</div>
<div class="col-first {% if loop.index is odd %}odd-row-color{% else %}even-row-color{% endif %}"><a href="{{ pkg.url | href }}">{{ pkg.name }}</a></div>
<div class="col-last {% if loop.index is odd %}odd-row-color{% else %}even-row-color{% endif %}"><div class="block">{{ pkg.firstSentence | doc }}</div></div>
{% endfor %}
</div>
</div>
{% endif %}
</main>
{% endblock %}
